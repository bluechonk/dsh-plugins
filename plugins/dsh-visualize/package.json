{
  "name": "@bluechonk/dsh-visualize",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件 @bluechonk/dsh-visualize：让模型把 HTML 页面作为对话内可交互可视化渲染出来——模型把页面写成文件、在回复里放一个 visualize 围栏，插件用沙箱 iframe 内联渲染（含 404/过大/越界等失败兜底）。",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/visualize-path.js",
    "client/client.js",
    "cordis.patch.yml",
    "skills/visualize/SKILL.md",
    "locale/*.json",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "check": "node scripts/check.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "visualize",
    "html",
    "iframe",
    "chat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluechonk/dsh-plugins.git",
    "directory": "plugins/dsh-visualize"
  },
  "homepage": "https://github.com/bluechonk/dsh-plugins/tree/main/plugins/dsh-visualize#readme",
  "bugs": {
    "url": "https://github.com/bluechonk/dsh-plugins/issues"
  },
  "author": "BlueChonk",
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  }
}
